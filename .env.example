# Copy to .env and change what you need. docker compose reads it automatically.

# Port the app is served on (http://localhost:8080)
PORT=8080

# Database (the db service in docker-compose.yml)
POSTGRES_USER=waypoint
POSTGRES_PASSWORD=waypoint
POSTGRES_DB=waypoint

# Signs the session tokens. Use a long random value in production.
JWT_SECRET=change-me-in-production

# Demo controls: the shared clock, the bad days portal, demo sign-in tiles and "Reset demo".
# Set to false for a real deployment: only real sign-ins, and no one can move the clock.
DEMO_MODE=true

# Secrets given to every seeded account (office roles use the password, drivers and depots the PIN).
SEED_PASSWORD=Waypoint@2026
SEED_PIN=246810

# Allowed browser origins for the API (comma-separated), or * for any.
CORS_ORIGIN=*

# Only for a separately hosted frontend (e.g. Vercel): the API's public URL, baked in at build time.
# Leave unset for docker compose (the API serves the app on the same origin).
# VITE_API_URL=https://waypoint-one-api.example.com
